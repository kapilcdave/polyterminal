# Kalshi API Key ID (from your Kalshi dashboard)
KALSHI_API_KEY=

# Path to your RSA private key file (downloaded when you created the API key)
KALSHI_PRIVATE_KEY_FILE=

# Environment: "demo" for paper trading, "prod" for real money
KALSHI_ENV=demo

# Polymarket L2 API credentials (optional).
# Required only for the authenticated user WebSocket stream.
POLYMARKET_API_KEY=
POLYMARKET_API_SECRET=
POLYMARKET_API_PASSPHRASE=

# Number of markets to load on startup/manual refresh
POLYTERMINAL_MARKET_LIMIT=100

# Explicitly opt into synthetic Kalshi data for offline demos
POLYTERMINAL_MOCK_DATA=false

# Python log level: DEBUG, INFO, WARNING, ERROR, or CRITICAL
POLYTERMINAL_LOG_LEVEL=WARNING
